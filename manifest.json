{
  "manifest_version": 3,
  "name": "Proton Mail When Ready",
  "version": "0.1.0",
  "description": "Hide the Proton Mail inbox until you choose to see it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "protonmail-when-ready@local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.proton.me/*"],
      "run_at": "document_start",
      "js": ["content.js"],
      "css": ["hide.css"]
    }
  ]
}
